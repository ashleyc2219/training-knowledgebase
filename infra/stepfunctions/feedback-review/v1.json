{
  "Comment": "Training KB feedback-review（設計 7.5）；五個 Task 呼叫同一個 Lambda，用 pipeline 與 task 名稱分派。一條直線，沒有 Choice 也沒有 Map（F49）。",
  "StartAt": "ListTargets",
  "States": {
    "CommitBatch": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed",
          "ResultPath": "$.failure"
        }
      ],
      "Next": "Succeeded",
      "Parameters": {
        "pipeline": "feedback-review",
        "state.$": "$",
        "task": "commit_batch"
      },
      "Resource": "${PipelineTaskFunctionArn}",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "TransientError"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2
        },
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2
        }
      ],
      "TimeoutSeconds": 120,
      "Type": "Task"
    },
    "EvaluateTargets": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed",
          "ResultPath": "$.failure"
        }
      ],
      "Next": "PrepareBatch",
      "Parameters": {
        "pipeline": "feedback-review",
        "state.$": "$",
        "task": "evaluate_targets"
      },
      "Resource": "${PipelineTaskFunctionArn}",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "TransientError"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2
        },
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2
        }
      ],
      "TimeoutSeconds": 120,
      "Type": "Task"
    },
    "InspectBatch": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed",
          "ResultPath": "$.failure"
        }
      ],
      "Next": "CommitBatch",
      "Parameters": {
        "pipeline": "feedback-review",
        "state.$": "$",
        "task": "inspect_batch"
      },
      "Resource": "${PipelineTaskFunctionArn}",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "TransientError"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2
        },
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2
        }
      ],
      "TimeoutSeconds": 120,
      "Type": "Task"
    },
    "ListTargets": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed",
          "ResultPath": "$.failure"
        }
      ],
      "Next": "EvaluateTargets",
      "Parameters": {
        "pipeline": "feedback-review",
        "state.$": "$",
        "task": "list_targets"
      },
      "Resource": "${PipelineTaskFunctionArn}",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "TransientError"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2
        },
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2
        }
      ],
      "TimeoutSeconds": 120,
      "Type": "Task"
    },
    "PipelineFailed": {
      "Cause": "本次整批失敗，不發布任何新版本",
      "Error": "PipelineFailed",
      "Type": "Fail"
    },
    "PrepareBatch": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PipelineFailed",
          "ResultPath": "$.failure"
        }
      ],
      "Next": "InspectBatch",
      "Parameters": {
        "pipeline": "feedback-review",
        "state.$": "$",
        "task": "prepare_batch"
      },
      "Resource": "${PipelineTaskFunctionArn}",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "TransientError"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2
        },
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2
        }
      ],
      "TimeoutSeconds": 120,
      "Type": "Task"
    },
    "Succeeded": {
      "Type": "Succeed"
    }
  }
}