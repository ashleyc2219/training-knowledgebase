# Training Knowledge Base 本機設定範本。
# 複製成 .env 再填值（.env 已被 git 忽略，不要提交）。
# 讀取順序：已 export 的環境變數 > 本檔 > 仍缺就停（publish_site.sh、demo.cli）。

# --- 本機碰雲端必填 -----------------------------------------------------------
# Demo 控制台與 publish_site.sh 沒有 region 會拒絕。
TKB_AWS_REGION=

# Data stack 部署後輸出的 TrainingKbBucketName，不要猜、不要抄別人的。
TKB_CONTENT_BUCKET=

# --- 通常不用改 ---------------------------------------------------------------
# 預設 training_kb；同一個帳號裡表名是固定的。
TKB_TABLE_NAME=

# 預設 demo。
TKB_PROJECT_ID=

# --- 模型（值來自 infra/scripts/check_models.py 實測；O5 未通過前留空）-----
TKB_BEDROCK_REGION=
TKB_EMBEDDING_MODEL_ID=
TKB_GENERATION_MODEL_ID=

# TKB_GITHUB_WEBHOOK_SECRET 不要寫在這裡。
# 只在 cdk deploy 當下的 shell 提供：openssl rand -hex 32
