# Training Knowledge Base 本機設定範本。
# 只列鍵名與說明，不含任何值；把值填進 .env（已被 .gitignore 忽略），不要提交。
# 三個鍵的值來自 infra/scripts/check_models.py 的實測輸出，O5 未通過前不得填猜測值。

# Bedrock 的 Region，例如 check_models.py --region 指定的那一個。
TKB_BEDROCK_REGION=

# Titan Text Embeddings V2 的 model ID（設計 §17.1 固定 1024 維）。
TKB_EMBEDDING_MODEL_ID=

# 生成模型的 model ID 或跨區推論 profile ID；O5 未通過時整行留空，不填猜測值。
TKB_GENERATION_MODEL_ID=

# GitHub webhook 驗簽密鑰：只在部署那一刻從 shell 提供給 CDK，不要把值寫進 .env。
# 產生方式：openssl rand -hex 32
TKB_GITHUB_WEBHOOK_SECRET=
